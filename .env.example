# Copy to `.env` and fill in your local MySQL credentials.
# Do not commit real passwords.

DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/hannibal_heritage"

# Used by the Prisma MariaDB driver adapter in src/lib/prisma.ts
DATABASE_HOST="localhost"
DATABASE_PORT=3306
DATABASE_USER="USER"
DATABASE_PASSWORD="PASSWORD"
DATABASE_NAME="hannibal_heritage"
