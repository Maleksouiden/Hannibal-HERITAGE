# Copy to `.env` and fill in credentials. Do not commit real passwords.
# Hostinger: use the remote MySQL host from hPanel — NOT localhost:3307.

DATABASE_URL="mysql://hannibal:hannibal@localhost:3307/hannibal_heritage"

# Used by the Prisma MariaDB driver adapter in src/lib/prisma.ts
DATABASE_HOST="localhost"
DATABASE_PORT=3307
DATABASE_USER="hannibal"
DATABASE_PASSWORD="hannibal"
DATABASE_NAME="hannibal_heritage"

# Local only: docker compose maps host 3307 → container 3306.
# docker compose up -d
# Hostinger production: set DATABASE_* + DATABASE_URL to Hostinger remote MySQL.

# Signed session cookies (SCRUM-61). Use a long random string locally.
AUTH_SECRET="change-me-to-a-long-random-secret"

# Seeded admin (prisma/seed.ts). Change before any shared environment.
ADMIN_EMAIL="admin@hannibal.local"
ADMIN_PASSWORD="admin1234"
ADMIN_NAME="Hannibal Admin"
# Comma-separated extras; seed also always promotes maleksouiden689@gmail.com.
# EXTRA_ADMIN_EMAILS="you@example.com"

# Admin background removal: Python rembg (primary). Install deps once:
#   python -m pip install -r requirements-rembg.txt
# Order: rembg → REMOVE_BG_API_KEY (optional paid fallback) → sharp chroma.
# BG_REMOVE_PYTHON="python3"
# BG_REMOVE_MODEL="isnet-general-use"
# BG_REMOVE_REMBG_SCRIPT="scripts/rembg_cli.py"
# BG_REMOVE_REFINE=1
# REMOVE_BG_API_KEY=""


