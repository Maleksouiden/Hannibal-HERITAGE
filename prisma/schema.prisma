// Hannibal HERITAGE — artisan e-commerce starter schema
// Catalogs planned: Sajnen + olive wood

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Catalog {
  SAJNEN
  OLIVE_WOOD
}

enum CurrencyCode {
  TND
  EUR
  USD
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?   @db.Text
  catalog     Catalog
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([catalog])
  @@index([parentId])
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  catalog     Catalog
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Price stored in minor units (e.g. millimes / cents)
  priceMinor  Int
  currency    CurrencyCode @default(TND)
  sku         String?  @unique
  stock       Int      @default(0)
  isPublished Boolean  @default(false)
  images      ProductImage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([catalog])
  @@index([categoryId])
  @@index([isPublished])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  @db.VarChar(2048)
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

/// Checkout / invoicing (SCRUM-13+). Runtime may still use file store for orders until dashboard wiring.
enum OrderStatus {
  PENDING_PAYMENT
  PAID_STUB
  CANCELLED
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique
  status             OrderStatus @default(PENDING_PAYMENT)
  email              String
  fullName           String
  phone              String?
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingPostalCode String
  shippingCountry    String
  /// Catalog totals always stored in TND minor units
  subtotalMinorTnd   Int
  /// Display currency chosen at checkout (server-converted)
  displayCurrency    String      @db.VarChar(3)
  subtotalDisplay    Float
  paymentStatus      String      @default("stub_pending")
  items              OrderItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([email])
  @@index([status])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalog          Catalog
  slug             String
  name             String
  quantity         Int
  unitPriceMinorTnd Int
  lineTotalMinorTnd Int

  @@index([orderId])
  @@index([catalog, slug])
}
